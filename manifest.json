{
  "manifest_version": 3,
  "name": "X Reply Name Grabber",
  "version": "1.0",
  "description": "Xでリプライする際に相手の名前を取得して挨拶をクリップボードにコピーします。",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy-name": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Alt+N"
      },
      "description": "Xのリプライ相手の名前を取得してコピー（ブラウザ拡張機能設定から変更可能）"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}